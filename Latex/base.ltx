% SÍMBOLOS UNICODE
% ==========================================
% pdflatex con inputenc solo entiende los caracteres que tenga declarados: uno
% suelto como ≠ aborta la compilación con «Unicode character not set up for use
% with LaTeX». Es un fallo habitual al pegar texto de una web o de una IA.
%
% Aquí se declaran los que faltaban de verdad; se comprobó cuáles compilando un
% documento de prueba con todos los candidatos y leyendo los avisos del log, así
% que los que ya funcionaban (→ ± × ÷ ° … — – « » ¿ ¡ € • ½) no se tocan.
\IfFileExists{newunicodechar.sty}{%
  \usepackage{newunicodechar}
  % Relaciones y operadores
  \newunicodechar{≠}{\ensuremath{\neq}}
  \newunicodechar{≤}{\ensuremath{\leq}}
  \newunicodechar{≥}{\ensuremath{\geq}}
  \newunicodechar{≈}{\ensuremath{\approx}}
  \newunicodechar{≡}{\ensuremath{\equiv}}
  \newunicodechar{≅}{\ensuremath{\cong}}
  \newunicodechar{∼}{\ensuremath{\sim}}
  \newunicodechar{∝}{\ensuremath{\propto}}
  \newunicodechar{∓}{\ensuremath{\mp}}
  \newunicodechar{⋅}{\ensuremath{\cdot}}
  \newunicodechar{∘}{\ensuremath{\circ}}
  \newunicodechar{−}{\ensuremath{-}}
  % Flechas que inputenc no trae
  \newunicodechar{↔}{\ensuremath{\leftrightarrow}}
  \newunicodechar{⇒}{\ensuremath{\Rightarrow}}
  \newunicodechar{⇐}{\ensuremath{\Leftarrow}}
  \newunicodechar{⇔}{\ensuremath{\Leftrightarrow}}
  % Conjuntos y lógica
  \newunicodechar{∈}{\ensuremath{\in}}
  \newunicodechar{∉}{\ensuremath{\notin}}
  \newunicodechar{⊂}{\ensuremath{\subset}}
  \newunicodechar{⊃}{\ensuremath{\supset}}
  \newunicodechar{⊆}{\ensuremath{\subseteq}}
  \newunicodechar{⊇}{\ensuremath{\supseteq}}
  \newunicodechar{∪}{\ensuremath{\cup}}
  \newunicodechar{∩}{\ensuremath{\cap}}
