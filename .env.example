# Datos que normalmente no cambian entre trabajos.
UNIVERSIDAD="Nombre de la universidad"
FACULTAD="Nombre de la facultad"
SEMESTRE="2026-2"

# Opcional: si se deja vacio o se borra, la portada omite la linea ALUMNO.
ALUMNO="Nombre del alumno"

# Opcional: integrantes del equipo separados por comas (o punto y coma).
# En la portada aparecen uno por renglon. --integrantes tiene prioridad.
#INTEGRANTES="Ana Ruiz, Luis Paz, Sofia Vela"

# Opcional: docente de la materia (--docente manda sobre esta variable).
#DOCENTE="Nombre del docente"

# Opcional: grupo de la materia (--grupo manda sobre esta variable).
#GRUPO="7-A"

# Opcional: carpeta con los logos de la portada, si los tienes fuera del
# proyecto. Debe contener logo-universidad.png y logo-facultad.png.
# Por omision se usa Latex/logos/. --logos manda sobre esta variable.
#LOGOS="/home/usuario/Documentos/logos-de-mi-universidad"
