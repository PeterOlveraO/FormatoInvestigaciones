# Data that usually stays the same between papers. Copy this file to .env.

# Required.
UNIVERSIDAD="Nombre de la universidad"
FACULTAD="Nombre de la facultad"
SEMESTRE="2026-2"

# Optional: your name for individual papers. If empty, the cover omits the line.
ALUMNO="Nombre del alumno"

# Optional: team members separated by commas (or semicolons), one per line on
# the cover. --members or a course profile take precedence.
#INTEGRANTES="Ana Ruiz, Luis Paz, Sofia Vela"

# Optional: teacher and group. --teacher/--group or a course profile take precedence.
#DOCENTE="Nombre del docente"
#GRUPO="7-A"

# Optional: folder with logo-universidad.png and logo-facultad.png, if you keep
# them outside the project. Default: templates/logos/. --logos takes precedence.
#LOGOS="/home/usuario/Documentos/logos-de-mi-universidad"

# Optional: interface language, es or en. The menu saves it the first time you
# choose. Without it, the system language is used.
#IDIOMA="es"
