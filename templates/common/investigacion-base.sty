  \newunicodechar{□}{\ensuremath{\square}}
  \newunicodechar{◆}{\ensuremath{\blacklozenge}}
  \newunicodechar{◇}{\ensuremath{\lozenge}}
  % Esquinas redondeadas: pmboxdraw declara las rectas (┌ ┐ └ ┘) pero no estas,
  % así que se reutiliza el mismo dibujo.
  \IfFileExists{pmboxdraw.sty}{%
    \newunicodechar{╭}{\textSFi}%
    \newunicodechar{╮}{\textSFiii}%
    \newunicodechar{╰}{\textSFii}%
    \newunicodechar{╯}{\textSFiv}%
  }{}
}{}

% ------------------------------------------------------------------
% Emoji
% ------------------------------------------------------------------
% Los emoji son parte de la sintaxis extendida de Markdown (pegados o escritos
% como :joy:) y ninguna fuente de pdflatex los tiene. twemojis sí: trae los de
% Twitter como páginas de un PDF y los inserta con \texttwemoji{<código hex>}.
%
% Declararlos uno por uno serían miles de líneas, así que en vez de una lista se
% aprovecha que inputenc ya calculó el punto de código del carácter que no supo
% componer: con él se arma el nombre del comando de twemojis y, si existe, se
% dibuja el emoji. Si no existe se cae al aviso de siempre.
%
% Los selectores de variación (U+FE0F, el que convierte ⚠ en ⚠️) y el unificador
% de emoji compuestos (U+200D) no se ven: se declaran vacíos para que no
% aparezca un [?] al lado de cada emoji.
\IfFileExists{newunicodechar.sty}{%
  \newunicodechar{️}{}%   U+FE0F selector de variación
  \newunicodechar{‍}{}%   U+200D unificador de ancho cero
}{}

% Punto de código decimal del carácter que inputenc no supo componer. El
% \decode@UTFviii de utf8.def es el mismo que usa LaTeX para su propio mensaje
% de error, así que el cálculo no lo inventa la plantilla.
\def\PuntoCodigoUnicode#1:#2\relax{\the\numexpr\decode@UTFviii#2\relax}
\ExplSyntaxOn
\cs_new:Npn \HexadecimalMinusculas #1 { \str_lowercase:f { \int_to_Hex:n {#1} } }
\ExplSyntaxOff

% Aviso en el log y un [?] visible en el PDF. Mismo criterio que
% validate_markdown(): avisar sin impedir que el trabajo se genere. El generador
% lee esos avisos del log y los muestra en la terminal, para que el símbolo
% perdido no pase inadvertido.
\def\SimboloSinDefinir#1{%
  \@latex@warning{Caracter Unicode sin definir:
    \expandafter\UTFviii@splitcsname\string#1\relax}%
  \textbf{[?]}%
}

% Red de seguridad: con las listas de arriba nunca se cubren TODOS los símbolos
% posibles. Antes de rendirse se prueba si twemojis conoce el carácter.
\@ifundefined{texttwemoji}{%
  \let\UTFviii@undefined@err\SimboloSinDefinir
}{%
  \def\UTFviii@undefined@err#1{%
    \begingroup
    \edef\@tempa{\HexadecimalMinusculas{\expandafter\PuntoCodigoUnicode\string#1\relax}}%
    \expandafter\ifcsname\expandafter t\expandafter w\expandafter e\expandafter m%
      \expandafter o\expandafter j\expandafter i\expandafter\space\@tempa\endcsname
      \expandafter\endgroup\expandafter\texttwemoji\expandafter{\@tempa}%
    \else
      \endgroup\SimboloSinDefinir{#1}%
    \fi
  }%
}

\endinput
