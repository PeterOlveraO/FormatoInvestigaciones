% investigacion-base.sty — la base universal que cargan todos los diseños.
% Contiene lo que la salida de Pandoc y los filtros dan por definido (tablas,
% imágenes, código, Unicode, emoji, gráficas). No impone ningún estilo: eso es
% trabajo del formato (templates/formats/<f>/format.sty), que el programa
% carga después de esta base. El idioma (babel) también lo pone el formato.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{investigacion-base}[2026/10/04 Base universal de los disenos]

% ==========================================
% PAQUETES BASE
% ==========================================
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{textcomp}                     % Simbolos (euro, grados, etc.)
\RequirePackage{setspace}                     % Interlineado
\RequirePackage{amsmath, amssymb}             % Matemáticas (debe ir antes de newtxmath)
\RequirePackage{xcolor}                       % Color (lo requiere el resaltado de código)
\RequirePackage{tikz}                         % Para dibujar la portada geométrica

% ==========================================
% GRÁFICAS DE DATOS
% ==========================================
% pgfplots dibuja dentro del propio pdflatex: la gráfica sale vectorial y con la
% misma tipografía que el texto, en vez de pegada como imagen de otro programa.
% Los bloques ```pgfplot del Markdown llegan aquí por resources/filters/charts.lua.
%
% El estilo por omisión es deliberadamente sobrio —escala de grises, rejilla
% tenue, línea de eje fina— porque el criterio del proyecto es no salirse de
% APA. Cada gráfica puede cambiar lo que quiera en su propio `\begin{axis}[...]`:
% estas opciones se aplican antes que las suyas.
\IfFileExists{pgfplots.sty}{%
  \RequirePackage{pgfplots}
  \pgfplotsset{compat=1.18}
  \usepgfplotslibrary{statistics}         % Caja y bigotes
}{}
\IfFileExists{pgfplotstable.sty}{\RequirePackage{pgfplotstable}}{}  % Datos desde CSV
\IfFileExists{pgf-pie.sty}{\RequirePackage{pgf-pie}}{}              % Gráfica de pastel

% ==========================================
% PAQUETES QUE NECESITA LA SALIDA DE PANDOC
% ==========================================
% Cualquier cambio aquí debe mantenerse alineado con lo que Pandoc genera:
%   pandoc archivo.md -s --to=latex   (revisar el preámbulo resultante)
\RequirePackage{graphicx}                     % Imágenes incluidas desde Markdown
\RequirePackage{longtable}                    % Tablas extensas de Markdown
\RequirePackage{booktabs}                     % Líneas de tablas generadas por Pandoc
\RequirePackage{array}                        % Columnas de tablas
\RequirePackage{calc}                         % \real{} en los anchos de columna de Pandoc
\RequirePackage{caption}                      % Pies de tabla y figura
\RequirePackage{etoolbox}                     % Parches para longtable
\RequirePackage{fancyvrb}                     % Bloques de código
\IfFileExists{framed.sty}{\RequirePackage{framed}}{}  % Fondo del código y cajas de nota
\RequirePackage{soul}                         % \hl{} para el resaltado (==texto==)
\IfFileExists{ulem.sty}{\RequirePackage[normalem]{ulem}}{}  % \sout y \uline
\IfFileExists{upquote.sty}{\RequirePackage{upquote}}{}  % Comillas rectas en verbatim
% Los diagramas de arte ASCII pegados dentro de un bloque de código usan los
% caracteres de dibujo de caja (└ ─ ┼ │); pmboxdraw los compone como reglas del
% ancho exacto de la letra monoespaciada, así que el dibujo no se desalinea.
\IfFileExists{pmboxdraw.sty}{\RequirePackage{pmboxdraw}}{}
% Los emoji se componen como imagen; ver el bloque SÍMBOLOS UNICODE.
\IfFileExists{twemojis.sty}{\RequirePackage{twemojis}}{}

% ------------------------------------------------------------------
% Tachado, resaltado y subrayado: por qué no se usan los de soul
% ------------------------------------------------------------------
% Pandoc emite \st (~~tachado~~), \hl (==resaltado==) y \ul (<u>subrayado</u>)
% contando con que los defina soul. Pero soul analiza el texto letra por letra y
% eso se le atraganta en dos sitios que un trabajo escolar usa a diario:
%   - dentro de longtable (la tabla de Pandoc) \st y \hl dejan a pdflatex dando
%     vueltas para siempre, sin error y sin PDF;
%   - en un título, el comando viaja al índice y la compilación aborta.
% ulem hace el tachado y el subrayado sin ese análisis, así que \st y \ul se
% redefinen sobre él cuando está instalado (si no lo está, siguen los de soul).
% Para el resaltado no hay sustituto que corte renglón, así que se conserva el
% de soul en el texto corriente y dentro de las tablas se cambia por un
% \colorbox, que no parte pero tampoco se cuelga.
% \DeclareRobustCommand evita, además, que el comando se expanda al escribir el
% índice o los marcadores del PDF.
\let\ResaltadoSoul\hl
\definecolor{ColorResaltado}{rgb}{1,0.94,0.4}
\sethlcolor{ColorResaltado}
\ifdefined\sout   % (\IfFileExists no sirve aquí: se comería el #1)
  \DeclareRobustCommand{\st}[1]{\sout{#1}}
  \DeclareRobustCommand{\ul}[1]{\uline{#1}}
\fi
\DeclareRobustCommand{\hl}[1]{\ResaltadoSoul{#1}}
\DeclareRobustCommand{\ResaltadoEnTabla}[1]{%
  \begingroup\setlength{\fboxsep}{1pt}\colorbox{ColorResaltado}{#1}\endgroup}
\AtBeginEnvironment{longtable}{\let\hl\ResaltadoEnTabla}

\IfFileExists{floatrow.sty}{%
  \RequirePackage{floatrow}
  % floatrow deja las tablas largas pegadas al margen izquierdo; longtable las
  % centra con \LTleft y \LTright a \fill, que es como salian antes.
  \AtBeginDocument{\setlength\LTleft{\fill}\setlength\LTright{\fill}}
}{}
\newcounter{none}                         % Pandoc usa \LTcaptype=none en tablas sin título

% Orden correcto de las tablas después de \paragraph o \subparagraph
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}

% Comandos que Pandoc espera encontrar definidos
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\providecommand{\passthrough}[1]{#1}

% ------------------------------------------------------------------
% Entornos que producen los filtros del generador
% ------------------------------------------------------------------
% `::: nota` y sus hermanas (aviso, ejemplo, definición) llegan aquí envueltas
% por resources/filters/blocks.lua. El marco es un filete fino y negro, sin color: una
% caja de colores desentonaría en un trabajo APA.
\ifdefined\FrameRule
  \newenvironment{CajaMarcada}[1]%
    {\begin{framed}\singlespacing\setlength{\parindent}{0pt}%
     \noindent\textbf{#1}\par\nobreak\vspace{2pt}}%
    {\end{framed}}
\else
  \newenvironment{CajaMarcada}[1]%
    {\begin{quote}\singlespacing\setlength{\parindent}{0pt}%
     \noindent\textbf{#1}\par\nobreak\vspace{2pt}}%
    {\end{quote}}
\fi

% La lista de referencias. Aquí es neutral (párrafos normales); cada formato
% la redefine: sangría francesa en APA y Harvard, numerada en IEEE.
\newenvironment{ReferenceList}{\par}{\par}

% Lo que el formato hace al empezar el cuerpo (alineación, sangría). Los
% diseños lo llaman después de su portada; el formato lo redefine.
\newcommand{\FormatBodySetup}{}

% Imágenes que nunca exceden el ancho ni el alto del texto
\newsavebox\pandoc@box
\providecommand*\pandocbounded[1]{%
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi%
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox{\pandoc@box}%
  \fi%
}
% Una figura de LaTeX «flota»: se va a donde quepa, y un diagrama puede acabar
% dos páginas después del párrafo que lo explica. En un trabajo escolar eso
% confunde más de lo que ayuda, así que con floatrow se fija donde se escribió.
% La colocación «H» la trae el propio floatrow; cargar además el paquete `float`
% es un error fatal, porque los dos hacen lo mismo. Sin floatrow se deja el
% `htbp` que espera Pandoc, que es el único valor válido entonces.
%
% Esta línea va aquí y no junto a floatrow porque Pandoc la fija en este punto:
% definida antes, la sobrescribiría y las figuras volverían a flotar.
\@ifundefined{floatsetup}{\def\fps@figure{htbp}}{\def\fps@figure{H}}

% Resaltado de sintaxis de los bloques de código de Pandoc
\newcommand{\VerbBar}{|}
\newcommand{\VERB}{\Verb[commandchars=\\\{\}]}
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{commandchars=\\\{\}}
% El código va sobre un fondo gris claro. `framed` es el paquete que la propia
% plantilla de Pandoc usaba para esto: `snugshade` ajusta la caja al contenido y,
% a diferencia de un \colorbox o un tcolorbox sin configurar, parte entre
% páginas, que es lo que necesita un listado largo.
\definecolor{FondoCodigo}{gray}{0.96}
\ifdefined\snugshade
  \colorlet{shadecolor}{FondoCodigo}
  \newenvironment{Shaded}{\begin{snugshade}\singlespacing\small}{\end{snugshade}}
\else
  \newenvironment{Shaded}{\singlespacing\small}{}
\fi
% Un bloque de código sin lenguaje llega como `verbatim`, que no pasa por
% Shaded y hereda el interlineado doble del documento: los diagramas de arte
% ASCII salen estirados y los conectores verticales (│ y |) con hueco entre
% renglón y renglón. Mismo tratamiento que Shaded.
\AtBeginEnvironment{verbatim}{\singlespacing\small}
