% Diseño «ieee-header»: título, autores y afiliación arriba y a lo ancho, como
% en un artículo de conferencia IEEE. Pensado para el formato ieee.
\documentclass[%%CLASS_OPTIONS%%]{article}

% Contrato del diseño: la base primero y, en la línea marcada abajo, el idioma
% y el formato que inserta el programa.
\usepackage{investigacion-base}
%%FORMAT%%

\newcommand{\TituloTrabajo}{%%TITULO%%}
\newcommand{\NombreAlumno}{%%ALUMNO%%}
\newcommand{\ListaIntegrantes}{%%INTEGRANTES%%}
\newcommand{\NombreMateria}{%%MATERIA%%}
\newcommand{\NombreMaestro}{%%DOCENTE%%}
\newcommand{\NombreFacultad}{%%FACULTAD%%}
\newcommand{\NombreUniversidad}{%%UNIVERSIDAD%%}
\newcommand{\FechaEntrega}{%%FECHA_ENTREGA%%}

% Cabecera IEEE: título grande, autores y afiliación en cursiva.
\newcommand{\IeeeHeader}{%
  \begin{center}
    {\Huge \TituloTrabajo\par}\vspace{1.2em}
    {\large \ifdefempty{\ListaIntegrantes}{\NombreAlumno}{\ListaIntegrantes}\par}\vspace{0.5em}
    {\itshape
      \ifdefempty{\NombreFacultad}{}{\NombreFacultad\par}
      \ifdefempty{\NombreUniversidad}{}{\NombreUniversidad\par}
      \ifdefempty{\NombreMateria}{}{\NombreMateria
        \ifdefempty{\NombreMaestro}{}{ \textperiodcentered{} \NombreMaestro}\par}
      \FechaEntrega\par}
  \end{center}
  \vspace{1.5em}}

\makeatletter
\newcommand{\IeeeStart}{\if@twocolumn\twocolumn[{\IeeeHeader}]\else\IeeeHeader\fi}
\makeatother

\usepackage{investigacion-final}

\begin{document}
\IeeeStart
\FormatBodySetup

%%CONTENIDO_MARKDOWN%%

\end{document}
