# Compilacion de Rust
/target/

# Entorno virtual y artefactos de Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Datos personales: la configuracion real de cada quien
.env

# PDFs generados y restos de una compilacion fallida
/output/
last-error.tex
last-error.log
ultimo-error.tex
ultimo-error.log

# Cache: imagenes descargadas de la web y diagramas dibujados con Graphviz.
# Se vuelven a generar solos, no tiene sentido versionarlos.
/cache/

# Trabajos propios en Markdown, que no son parte del proyecto
/input/

# Los logos de tu institucion NO se suben: normalmente no son redistribuibles.
# Cada quien deja los suyos en templates/logos/ (ver el LEEME de esa carpeta) o
# en la carpeta que indique --logos.
templates/logos/*
!templates/logos/LEEME.md
templates/*/logos/

# Perfiles de materia: llevan nombres de docentes, son datos de cada quien.
subjects/*
!subjects/example.toml
!subjects/LEEME.md

# Restos de editores y del sistema
*.save
*~
.DS_Store
